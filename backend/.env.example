# URL del webhook del trigger "When chat message received" en n8n (POST /chat la llama)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/TU_WEBHOOK_ID/chat

# Conexión a MongoDB local y nombre de la base de datos utilizada por la API
MONGO_URI=mongodb://localhost:27017/tiempo_db

# Puerto donde escucha Express
PORT=4000

# Credenciales de Google OAuth 2.0 (modo Testing)
GOOGLE_CLIENT_ID=TU_VALOR_AQUI
GOOGLE_CLIENT_SECRET=TU_VALOR_AQUI
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Tokens y sesiones
JWT_SECRET=TU_VALOR_AQUI  # firma los JWT con 7 días de validez
SESSION_SECRET=TU_VALOR_AQUI  # utilizado por express-session
FRONTEND_URL=http://localhost:5173  # destino del redirect tras el login

# Secreto interno compartido con n8n (header x-internal-secret)
N8N_INTERNAL_SECRET=TU_VALOR_AQUI

# Clave AES-256-GCM en base64 de 32 bytes usada para cifrar los tokens de Google
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY_BASE64=TU_VALOR_AQUI
